#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# Easytier 2.6.4 supervision for the SK-D840N jffs2 image.
#
# easytier-core is a static musl aarch64 ELF that needs /dev/net/tun, which
# this target provides as a kernel built-in (CONFIG_TUN=y) instead of a kmod
# package. The upstream init script is 908 lines of bashisms and downloads
# binaries at runtime; this one only supervises the installed binary.

START=99
STOP=10
USE_PROCD=1

in_build() {
	[ -n "${IPKG_INSTROOT:-}${PKG_ROOT:-}${CI:-}" ]
}

start_service() {
	config_load easytier
	local enabled bin config_file log extra_args
	config_get_bool enabled 'main' 'enabled' 0
	config_get bin 'main' 'bin' '/usr/bin/easytier-core'
	config_get config_file 'main' 'config_file' '/etc/easytier/config.toml'
	config_get log 'main' 'log' 'warn'
	config_get extra_args 'main' 'extra_args' ''

	[ "$enabled" = "1" ] || return 0
	[ -x "$bin" ] || {
		logger -p daemon.err -t easytier "binary $bin is missing or not executable"
		return 0
	}
	[ -r "$config_file" ] || {
		logger -p daemon.err -t easytier "config $config_file is missing"
		return 0
	}

	procd_open_instance 'easytier-core'
	# The log level is a command line flag; it is not read from the toml file.
	procd_set_param command "$bin" -c "$config_file" --console-log-level "$log" $extra_args
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="4096 4096"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger 'easytier'
}
