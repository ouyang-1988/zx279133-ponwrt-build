#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# sk-txfix - re-apply the LAN tx-checksum-off policy on every boot.
#
# 99-sk-txfix in uci-defaults only runs when /etc is freshly seeded. A
# sysupgrade that keeps configuration (or any later `uci commit` that rewrites
# /etc/config/firewall) leaves the hardware offload flag back at its default,
# so the policy is enforced here, after the network is up.

START=21
STOP=10
USE_PROCD=1

in_build() {
	[ -n "${IPKG_INSTROOT:-}${PKG_ROOT:-}${CI:-}" ]
}

apply_txfix() {
	in_build && return 0
	command -v ethtool >/dev/null 2>&1 || return 0

	for dev in lan-cpu0 br-lan lan0 lan1 lan2 lan3 lan4 eth0 lan-cpu1; do
		[ -e "/sys/class/net/$dev" ] || continue
		ethtool -K "$dev" tx off 2>/dev/null
	done
}

start_service() {
	in_build && return 0

	apply_txfix

	if command -v uci >/dev/null 2>&1; then
		[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "0" ] || {
			uci -q set firewall.@defaults[0].flow_offloading_hw='0'
			uci -q commit firewall
			/etc/init.d/firewall reload >/dev/null 2>&1
		}
	fi
}

stop_service() {
	: # nothing to undo; leaving checksums off is the safe direction
}

reload_service() {
	apply_txfix
}
